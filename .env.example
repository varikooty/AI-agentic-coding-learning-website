# Server-side only — never exposed to the browser. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for both grading (judge calls) and the coach panel.
GEMINI_MODEL=gemini-3.6-flash

# Powers the agentic track (lib/agent/*) — a coding agent and its judge.
# Server-side only. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides for the agentic track. Groq is OpenAI-compatible, so
# GROQ_BASE_URL can point at any other OpenAI-compatible /chat/completions host.
# AGENT_GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
